# Jynx — single root environment file.
# Copy this to `.env` (`cp .env.example .env`) and edit. One file configures
# everything: Docker Compose, the FastAPI backend, and the Next.js frontend.
#
#   cp .env.example .env

# ── LLM (OpenAI-compatible endpoint, used by the backend) ───────────────────
# Any OpenAI-compatible chat-completions endpoint works (Olla, Ollama, vLLM,
# OpenAI, ...). Defaults target a local Olla instance load-balancing Ollama.
OPENAI_BASE_URL=http://localhost:40114/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:14b

# ── Backend server bind (optional) ──────────────────────────────────────────
# The backend binds to 0.0.0.0:8000 by default (reachable on your network).
# Uncomment to override.
# HOST=0.0.0.0
# PORT=8000

# ── Frontend → backend ──────────────────────────────────────────────────────
# The frontend is SINGLE-ORIGIN: the browser calls a relative /api/... path on
# whatever host served the page, and the Next.js server proxies it to the
# backend (next.config.mjs rewrites). So opening http://<server-ip>:4000 from
# any device "just works" — no IP to hardcode, no CORS.
#
# BACKEND_ORIGIN is where the NEXT SERVER forwards /api/* (server-side only;
# the browser never sees it). Default suits local dev.
BACKEND_ORIGIN=http://localhost:8000
#
# Optional escape hatch: set NEXT_PUBLIC_API_BASE_URL to bypass the proxy and
# have the browser call a backend on a different host directly (then that host
# must allow CORS). Leave unset to use the proxy.
#   NEXT_PUBLIC_API_BASE_URL=http://10.0.0.5:8000

# ── Docker note ─────────────────────────────────────────────────────────────
# Docker Compose auto-loads this file. To reach an LLM endpoint running on the
# HOST machine from inside the containers, set:
#   OPENAI_BASE_URL=http://host.docker.internal:40114/v1
