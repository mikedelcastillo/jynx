# Jynx — single root environment file.
# Copy this to `.env` (`cp .env.example .env`) and edit. One file configures
# everything: Docker Compose, the FastAPI backend, and the Next.js frontend.
#
#   cp .env.example .env

# ── LLM (OpenAI-compatible endpoint, used by the backend) ───────────────────
# Any OpenAI-compatible chat-completions endpoint works (Olla, Ollama, vLLM,
# OpenAI, ...). Defaults target a local Olla instance load-balancing Ollama.
OPENAI_BASE_URL=http://localhost:40114/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:14b

# ── Chunk-size optimization (backend) ───────────────────────────────────────
# On startup the backend probes the model's context window (Ollama /api/show)
# and sizes each chunk to fill it (fewer, larger LLM calls), then sends num_ctx
# so Ollama allocates the full window instead of truncating to its ~4096
# default. Probed values are cached per-model so reload/model-switch never
# re-probes. Default: enabled.
CHUNK_OPTIMIZATION_ENABLED=true
#
# Context window (tokens). If your endpoint doesn't expose /api/show (e.g. it's
# behind olla), set this — it's both the probe fallback AND a hard cap on the
# probed value. Leave unset to trust the probe (fallback 8192).
# MODEL_CONTEXT_WINDOW=8192
#
# Fine-tuning (defaults shown):
# OUTPUT_RESERVE_TOKENS=1500     # reserved for the generated quiz JSON
# PROMPT_OVERHEAD_TOKENS=600     # system prompt + scaffolding
# TOKENS_PER_WORD=1.3            # raise toward 1.5 if you see truncation
# CONTEXT_SAFETY_FRACTION=0.9
# MIN_CHUNK_WORDS=300
# MAX_CHUNK_WORDS=8000
# PROBE_TIMEOUT=3
# PROBE_CACHE_PATH=backend/.cache/context_windows.json

# ── Quiz reduce step (backend) ──────────────────────────────────────────────
# After generation, an optional LLM "selector" picks the best N-of-M questions
# (deduped, source-balanced). It's bounded by REDUCE_DEADLINE_SECONDS; on
# timeout it falls back to an instant deterministic balanced trim. Reasoning
# models (e.g. qwen3) "think" too long to ever finish the pick and just burn the
# deadline — set this false for them to skip straight to the fast fallback.
# REDUCE_LLM_SELECTION_ENABLED=true
# REDUCE_DEADLINE_SECONDS=8

# ── Link crawling (backend) ─────────────────────────────────────────────────
# crawl_depth is chosen per request in the UI (0-5, default 1). 0 = no crawling.
# When > 0, the backend follows the LLM-judged most-relevant links off each page
# up to that many levels deep; crawled pages become extra quiz sources. When
# crawling, EVERY crawled page contributes questions (the map early-stop is off)
# and reduce ranks the final set by relevance to the original seed topic
# (regardless of REDUCE_LLM_SELECTION_ENABLED). Defaults shown:
# DEFAULT_CRAWL_DEPTH=1
# MAX_CRAWL_DEPTH=5
# CRAWL_MAX_LINKS_PER_PAGE=4         # top-N relevant links followed per page
# CRAWL_MAX_CANDIDATES_PER_PAGE=40   # links offered to the relevance LLM per page
# CRAWL_MAX_TOTAL_PAGES=20           # global cap on pages fetched by crawling
# CRAWL_RELEVANCE_DEADLINE_SECONDS=15
# CRAWL_RELEVANCE_RETRIES=3          # retry empty/failed link picks (model is flaky)
# CRAWL_RELEVANCE_TEMPERATURE=0.1    # low temp -> consistent, decisive picks
# CRAWL_REDUCE_DEADLINE_SECONDS=30   # reduce ranks a larger pool when crawling
# CRAWL_RELEVANCE_CONTEXT_CHARS=2000
# CRAWL_SEED_TOPIC_CHARS=1500

# ── Reasoning models (backend) ──────────────────────────────────────────────
# Reasoning models (e.g. qwen3) waste GPU streaming a long chain-of-thought with
# empty content before the answer. The quiz task is JSON extraction and needs no
# reasoning, so we send reasoning_effort to skip it (the only lever Ollama/olla
# honor). Set to "" to omit the field for endpoints that reject it.
# LLM_REASONING_EFFORT=none

# ── Backend server bind (optional) ──────────────────────────────────────────
# The backend binds to 0.0.0.0:8000 by default (reachable on your network).
# Uncomment to override.
# HOST=0.0.0.0
# PORT=8000

# ── Frontend → backend ──────────────────────────────────────────────────────
# The frontend is SINGLE-ORIGIN: the browser calls a relative /api/... path on
# whatever host served the page, and the Next.js server proxies it to the
# backend (next.config.mjs rewrites). So opening http://<server-ip>:4000 from
# any device "just works" — no IP to hardcode, no CORS.
#
# BACKEND_ORIGIN is where the NEXT SERVER forwards /api/* (server-side only;
# the browser never sees it). Default suits local dev.
BACKEND_ORIGIN=http://localhost:8000
#
# Optional escape hatch: set NEXT_PUBLIC_API_BASE_URL to bypass the proxy and
# have the browser call a backend on a different host directly (then that host
# must allow CORS). Leave unset to use the proxy.
#   NEXT_PUBLIC_API_BASE_URL=http://10.0.0.5:8000

# ── Docker note ─────────────────────────────────────────────────────────────
# Docker Compose auto-loads this file. To reach an LLM endpoint running on the
# HOST machine from inside the containers, set:
#   OPENAI_BASE_URL=http://host.docker.internal:40114/v1
